# Secrets : jamais dans Git (seuls les fichiers *.example sont suivis)
.env
.env.*
!.env.example
!.env.*.example

# Dépendances et builds
node_modules/
vendor/
dist/
public/build/
public/hot

# Fichiers générés par Laravel
backend/public/storage
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/bootstrap/cache/*.php
*.sqlite
*.sqlite-journal
*.log
.phpunit.result.cache
.phpunit.cache/

# Sauvegardes, dumps et clés
*.sql
*.tar.gz
*.zip
*.pem
*.key

# Éditeurs et OS
.idea/
.vscode/
.DS_Store
Thumbs.db
