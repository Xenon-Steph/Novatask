APP_ENV=production
APP_DEBUG=false
APP_URL=https://tasks.example.com
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=tasks.example.com
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=novatask
DB_USERNAME=novatask_app
DB_PASSWORD=REPLACE_WITH_SECURE_SECRET
NOVATASK_AI_KEY=REPLACE_WITH_SECRET_API_KEY
NOVATASK_AI_MODEL=REPLACE_WITH_SUPPORTED_MODEL
# APP_KEY: generate with php artisan key:generate; never commit secrets.
